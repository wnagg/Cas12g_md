; ===== 500 ps NPT without position restraints =====
integrator   = md
dt           = 0.002
nsteps       = 250000          ; 500 ps

continuation = yes
gen_vel      = no

cutoff-scheme = Verlet
nstlist      = 20
rlist        = 1.0
coulombtype  = PME
rcoulomb     = 1.0
vdwtype      = Cut-off
rvdw         = 1.0
pbc          = xyz

constraints  = h-bonds
constraint_algorithm = lincs
lincs_iter   = 1
lincs_order  = 4

tcoupl       = V-rescale
tc-grps      = Protein Water_and_ions
tau_t        = 0.1   0.1
ref_t        = 300   300

pcoupl       = C-rescale
pcoupltype   = isotropic
tau_p        = 5.0
ref_p        = 1.0
compressibility = 4.5e-5

nstxout-compressed = 500
nstenergy          = 1000
nstlog             = 1000
