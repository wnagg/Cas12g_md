; ===== 500 ns Production MD, NPT, no position restraints =====
integrator   = md
dt           = 0.002
nsteps       = 250000000        ; 500 ns

continuation = yes
gen_vel      = no

cutoff-scheme = Verlet
nstlist      = 100
rlist        = 1.0
coulombtype  = PME
rcoulomb     = 1.0
vdwtype      = Cut-off
rvdw         = 1.0
DispCorr     = EnerPres
pbc          = xyz

constraints  = h-bonds
constraint_algorithm = lincs
lincs_iter   = 1
lincs_order  = 4

tcoupl       = V-rescale
tc-grps      = Protein Water_and_ions
tau_t        = 0.1   0.1
ref_t        = 300   300

pcoupl       = C-rescale
pcoupltype   = isotropic
tau_p        = 5.0
ref_p        = 1.0
compressibility = 4.5e-5

nstxout      = 0
nstvout      = 0
nstfout      = 0
nstenergy    = 5000             ; 10 ps
nstlog       = 5000             ; 10 ps
nstxout-compressed = 50000      ; 100 ps
