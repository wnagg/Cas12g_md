# Cas12g_predict_F616N GROMACS MD configuration example
# Copy this file and edit INPUT_PDB and WORKDIR before running.

GMX=/home/haichao/gromacs-gpu/bin/gmx
INPUT_PDB=/home/haichao/sxd/02/Cas12g_predict_F616N.pdb
WORKDIR=/home/haichao/sxd/02/md_Cas12g_predict_F616N_500ns
SYSTEM_NAME=Cas12g_predict_F616N

FORCEFIELD=amber99sb-ildn
WATER=tip3p
BOX_TYPE=dodecahedron
BOX_DIST_NM=1.0
SALT_MOLAR=0.15
TEMP_K=300
PRESSURE_BAR=1.0

# Protein-only structures should keep this as yes.
# Do not use this workflow directly for ligand/metal/cofactor/nonstandard residue systems.
PREPARE_PROTEIN_ONLY=yes

NVT_PS=100
NPT_CA_PS=1000
NPT_NOCA_PS=500

# Use MD_NS=1 for the first test run; use 500 for the production run.
MD_NS=500
DT_PS=0.002
XTC_INTERVAL_PS=100
ENERGY_INTERVAL_PS=10
LOG_INTERVAL_PS=10
CHECKPOINT_MIN=15

CA_FC=1000
USE_GATE_CA=no
GATE_RESID=681
GATE_FC=1000

MDRUN_CPU_OPTS="-nb cpu -pme cpu"
MDRUN_GPU_OPTS="-nb gpu -pme gpu -bonded gpu -update gpu"
MAXWARN=1

RUN_LIGHT_ANALYSIS=yes
ANALYSIS_BEGIN_NS=50
CLEAN_EQUIL_XTC=no
