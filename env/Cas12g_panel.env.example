# Copy to env/Cas12g_panel.env and edit machine-specific paths.
GMX=/home/haichao/gromacs-gpu/bin/gmx
PYMOL=pymol
PYTHON=python3
WT_PDB=/home/haichao/Desktop/SXD/Cas12g_predict.pdb
CHAIN=A
WORKDIR=/home/haichao/sxd/02/Cas12g_panel_md_100ns
VARIANTS="WT F616N R184S V623Q V623S"
REBUILD_MUTANTS=no

FORCEFIELD=amber99sb-ildn
WATER=tip3p
BOX_TYPE=dodecahedron
BOX_DIST_NM=1.0
SALT_MOLAR=0.15
TEMP_K=300
PRESSURE_BAR=1.0
PREPARE_PROTEIN_ONLY=yes

# Retain the previously used equilibration protocol.
NVT_PS=100
NPT_CA_PS=1000
NPT_NOCA_PS=500

# Resource-conscious screening settings; do not interpret 100 ns as proof of convergence.
MD_NS=100
DT_PS=0.002
XTC_INTERVAL_PS=50
ENERGY_INTERVAL_PS=10
LOG_INTERVAL_PS=10
CHECKPOINT_MIN=15
MD_DEFFNM=md500

CA_FC=1000
USE_GATE_CA=no
GATE_RESID=681
GATE_FC=1000
MDRUN_CPU_OPTS="-nb cpu -pme cpu"
MDRUN_GPU_OPTS="-nb gpu -pme gpu -bonded gpu -update gpu"
MAXWARN=1

ANALYSIS_BEGIN_NS=20
FEL_BINS=30
CLEAN_INTERMEDIATES=yes
